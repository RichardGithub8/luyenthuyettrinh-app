{
  "compilerOptions": {
    "target": "ES2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "outDir": ".test-dist",
    "rewriteRelativeImportExtensions": true,
    "strict": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "tests/**/*.ts",
    "src/domain/**/*.ts",
    "src/ai/core/**/*.ts",
    "src/payments/core.ts"
  ]
}
