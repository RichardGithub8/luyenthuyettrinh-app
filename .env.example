# ============================================================
# luyenthuyettrinh.com · biến môi trường
# Sao chép thành .env.local rồi điền giá trị. KHÔNG commit .env.local.
# ============================================================

# --- Ứng dụng ---
# Domain chính thức. BỎ TRỐNG khi chạy trên Vercel: tự dùng VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL.
# Mọi link email, callback Auth, return/IPN thanh toán đều dựng từ giá trị này (src/lib/urls.ts).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
PUBLIC_API_URL=                     # chỉ đặt nếu URL nhận IPN khác SITE_URL (vd. tunnel ngrok khi test local)
LOG_LEVEL=info                      # debug | info | warn | error
MEDIA_RETENTION_DAYS=30             # số ngày giữ tệp ghi âm/video gốc

# --- Supabase (Phase 1) ---
# Local: chạy `npx supabase start`, lấy giá trị từ output (API URL, anon key, service_role key).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # chỉ dùng ở server, bỏ qua RLS. Tuyệt đối không đưa ra client.

# --- Google OAuth qua Supabase Auth (Phase 1, tùy chọn) ---
# Tạo OAuth client trên Google Cloud Console, redirect URI: <SUPABASE_URL>/auth/v1/callback
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# --- Email (Resend) ---
# Thiếu RESEND_API_KEY hoặc EMAIL_FROM → tự dùng chế độ mock (ghi log + bảng email_messages), không chặn chức năng khác.
EMAIL_PROVIDER=                     # resend | mock | (trống = tự chọn)
RESEND_API_KEY=
EMAIL_FROM=                         # "luyenthuyettrinh.com <no-reply@mail.your-domain.com>" (domain đã xác minh trên Resend)
EMAIL_REPLY_TO=

# --- AI pipeline (Phase 3) ---
# Mọi dịch vụ đều có chế độ mock: thiếu khóa → tự dùng mock, pipeline vẫn chạy trọn để demo/kiểm thử.
ANALYSIS_QUEUE=                     # trigger | inline | (trống: có TRIGGER_SECRET_KEY → trigger, không thì inline)
TRIGGER_PROJECT_ID=                 # proj_xxx (Trigger.dev Dashboard → Project settings)
TRIGGER_SECRET_KEY=                 # tr_dev_xxx / tr_prod_xxx

STT_PROVIDER=                       # groq | mock | (trống = tự chọn)
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3-turbo

LLM_PROVIDER=                       # deepseek | mock | (trống = tự chọn)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

FFMPEG_PATH=                        # trên Trigger.dev do extension ffmpeg() tự đặt; local: đường dẫn ffmpeg nếu muốn tách âm thanh video

# --- Thanh toán (Phase 4). Cổng nào có đủ khóa thì tự bật; mock bật mặc định ---
PAYMENT_MOCK_ENABLED=true           # false khi đã có MoMo/VNPay thật (tắt cổng mô phỏng ở production)
MOCK_PAYMENT_SECRET=                # trống: tự sinh từ SUPABASE_SERVICE_ROLE_KEY
PAYMENT_TTL_MIN=15                  # đơn chưa trả quá thời gian này → hết hạn

# --- MoMo (Phase 4) · sandbox: https://developers.momo.vn ---
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create

# --- VNPay (Phase 4) · sandbox: https://sandbox.vnpayment.vn ---
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# IPN URL của VNPay khai báo trong trang quản trị merchant: <PUBLIC_API_URL>/api/payments/vnpay/ipn

# --- Cron dọn dữ liệu (Vercel Cron tự gửi header Authorization: Bearer $CRON_SECRET) ---
CRON_SECRET=                        # ≥ 16 ký tự ngẫu nhiên: openssl rand -hex 32
